{
  "name": "n8n-nodes-compdf",
  "version": "1.0.6",
  "description": "n8n community node for ComPDF API - async document processing",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ComPDF-Youna/n8n-nodes-compdf",
  "author": {
    "name": "ComPDF",
    "email": "support@compdf.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ComPDF-Youna/n8n-nodes-compdf.git"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && gulp build:assets",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CompdfApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Compdf/Compdf.node.js"
    ]
  },
  "dependencies": {},
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.49.1",
    "@types/node": "^25.3.3",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.0.0"
  }
}
